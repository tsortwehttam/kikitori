#!/usr/bin/env python3
"""Speak a line in one of the episode's voices, to test how the TTS reads it.

    ./say narrator "こんにちは、今日はいい天気ですね。"
    ./say m "テストです。"
    ./say aivis:コハク "テストです。"

Voices: narrator, f, m, card, en, or any voice build.py accepts (aivis:NAME, say:NAME).
Uses the local AivisSpeech engine, starting it if needed. The clip is saved to build/say.mp3.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
import build  # noqa: E402

if len(sys.argv) < 3 or sys.argv[1] in ("-h", "--help"):
    raise SystemExit(__doc__)
role, text = sys.argv[1], " ".join(sys.argv[2:])
if ":" not in role and role not in build.VOICES["aivis"] and role != "en":
    raise SystemExit(f"Unknown voice {role!r}. Use one of: {', '.join(build.VOICES['aivis'])}, en, or aivis:NAME.")
out = build.build({"title": "say", "lines": [{"say": role, "text": text}]}, "aivis",
                  os.path.join(ROOT, "build", "say.mp3"))
subprocess.run(["afplay", out])
